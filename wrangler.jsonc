{
  "name": "4ndra",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "4ndra.com", "custom_domain": true },
    { "pattern": "www.4ndra.com", "custom_domain": true },
    { "pattern": "*.4ndra.com/*", "zone_name": "4ndra.com" }
  ]
}
